{"metrics":[{"metric":"Altman Z-score","metric_code":"ALTMAN_Z_SCORE","description":"Predicts bankruptcy risk; low score (<1.8) signals distress.","bucket":"Leverage","normal_range":">2.99 (safe), 1.81–2.99 (grey), <1.81 (distress)","industry_median":7.5,"formula":"1.2×(WC/TA) + 1.4×(RE/TA) + 3.3×(EBIT/TA) + 0.6×(MVE/TL) + 1.0×(S/TA)","category":"decimal","threshold_redflag_sign":"<","threshold_1":1.81,"threshold_2":0.0,"2021":"1.5155","2022":"1.6097","2023":"1.9205","2024":"1.6889","2025":"1.1944","2026":"-"},{"metric":"Altman Z-score (private Firms)","metric_code":"ALTMAN_Z_SCORE_PRIVATE","description":"Bankruptcy prediction for private firms; <1.23 signals high risk.","bucket":"Other","normal_range":">2.9 (safe), <1.23 (distress)","industry_median":7.5,"formula":"0.717×(WC/TA) + 0.847×(RE/TA) + 3.107×(EBIT/TA) + 0.420×(BVE/TL) + 0.998×(S/TA)","category":"decimal","threshold_redflag_sign":"<","threshold_1":1.23,"threshold_2":0.0,"2021":"1.0035","2022":"1.0697","2023":"1.2794","2024":"1.0994","2025":"0.7703","2026":"-"},{"metric":"Altman Z-score Emerging","metric_code":"ALTMAN_Z_SCORE_EMERGING","description":"Modified Z-score for emerging markets; low score = distress risk.","bucket":"Other","normal_range":">2.6 (safe), <1.1 (distress)","industry_median":7.5,"formula":"6.56×(WC/TA) + 3.26×(RE/TA) + 6.72×(EBIT/TA) + 1.05×(BVE/TL)","category":"decimal","threshold_redflag_sign":"<","threshold_1":1.0,"threshold_2":0.0,"2021":"6.7023","2022":"6.7361","2023":"9.1097","2024":"8.3971","2025":"6.0636","2026":"-"},{"metric":"Asset Quality Index","metric_code":"ASSET_QUALITY_INDEX","description":"Measures proportion of non-productive assets; high ratio = inefficiency.","bucket":"Other","normal_range":"<1 preferable","industry_median":7.5,"formula":"[1 – ((Current Assetst + PP&E + Total Long-term Investments[t])/Total Assets[t])] / [1 – ((Current Assetst-1 + PP&E[t-1] + Total Long-term Investments[t-1]) / Total Assets[t-1])]","category":"decimal","threshold_redflag_sign":">","